{
  "name": "fitlife-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs",
    "test:qa": "node qa/test.mjs && npm run test:mobile && npm run test:features && npm run test:security && npm run test:guides && npm run test:personal && npm run test:accessibility && npm run test:motion",
    "test:offline": "node qa/offline.mjs",
    "test:theme": "node qa/theme-reveal.mjs",
    "test:motion": "node qa/motion.mjs",
    "test:standalone": "node qa/standalone.mjs",
    "test:updates": "node qa/updates.mjs",
    "test:native": "bash android/tests/run.sh",
    "test:mobile": "node qa/mobile.mjs",
    "test:features": "node qa/features.mjs && node qa/native-backup.mjs && node qa/feature-layouts.mjs && npm run test:loader && npm run test:nutrition",
    "test:loader": "node qa/loader.mjs",
    "test:security": "node qa/security.mjs",
    "test:cloud": "node qa/cloud-unit.mjs && node qa/cloud-browser.mjs",
    "test:rules": "python3 qa/firestore-rules.py",
    "test:nutrition": "node qa/nutrition-unit.mjs && node qa/iteration.mjs",
    "test:guides": "node qa/guides.mjs && node qa/guides-upgrades.mjs",
    "test:personal": "node qa/personal-unit.mjs && node qa/personal-browser.mjs && node qa/personal-backup.mjs && node qa/personal-recovery.mjs",
    "test:accessibility": "node qa/accessibility.mjs && node qa/theme-accessibility.mjs",
    "test:phase0": "node qa/phase0-unit.mjs && node qa/phase0-browser.mjs",
    "test:exercises": "node qa/exercise-unit.mjs && node qa/exercise-browser.mjs",
    "test:motion-water": "node qa/motion-reminders-unit.mjs && node qa/motion-reminders-browser.mjs"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
